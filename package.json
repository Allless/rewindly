{
  "name": "rewindly",
  "version": "1.0.0",
  "private": true,
  "repository": "github:Allless/rewindly",
  "homepage": "https://allless.github.io/rewindly/",
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc && node scripts/sync-favicon.mjs && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@preact/preset-vite": "^2.10.3",
    "@types/qrcode": "^1.5.5",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "preact-render-to-string": "^6.7.0",
    "prettier": "^3.8.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.54.0",
    "vite": "^7.3.1",
    "vite-plugin-node-polyfills": "^0.24.0",
    "vite-plugin-svgr": "^5.2.0",
    "vitest": "^4.0.18"
  },
  "dependencies": {
    "@fontsource/fraunces": "^5.3.0",
    "fflate": "^0.8.3",
    "preact": "^10.28.3",
    "qrcode": "^1.5.4",
    "telegram": "^2.26.22"
  }
}
